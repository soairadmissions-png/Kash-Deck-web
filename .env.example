# CashDeck Environment Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
# If DATABASE_URL is not provided, CashDeck uses embedded PGlite (Postgres WebAssembly) in ./data/cashdeck.db
DATABASE_URL=
DB_STORAGE_DIR=./data/cashdeck.db

# Authentication Secrets
JWT_ACCESS_SECRET=cashdeck_super_secret_access_jwt_key_32chars_min!
JWT_REFRESH_SECRET=cashdeck_super_secret_refresh_jwt_key_32chars_min!
SESSION_COOKIE_SECRET=cashdeck_session_cookie_secret_key_32chars_min!

# AI Assistant
GEMINI_API_KEY=

# Payments (Paystack sandbox)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Notifications (Email/SMS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notifications@cashdeck.ng
SMS_PROVIDER=console

# Feature Flags
ENABLE_DEV_ROUTES=false
ENABLE_DEMO_SEED=true
